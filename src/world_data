////	Tile-Specific Callbacks

static void __tcb_secure_cargo(void *_) {
	Sound_SFX_Play(SFX_DIT_UP, -1);
	g_World.txt = "\x1B\x02\x00\x0B""ENGAGING AUTOMATIC CARGO SECURING MECHANISMS...\n"
		"\x1B\x02\x00\x07""SUCCESS!\n"
		"CARGO IS SECURE.";
	
	// Replace cargo interface with generic dummy interface
	World_Room_SetTile(2, 4, 0x17);

	Gamestate_SetFlag(GFLAG_S_CARGO_SECURE, 1);
	Gamestate_SetFlag(GFLAG_ERUYA_DIA, 0x02);	// Eruya trusts you now, alternative dialogue
}

static void __tcb_save_game(void *_) {
	Gamestate_Save(g_CurrentGame.curr_slot);

	g_World.txt = "\x1B\x02\x00\x07""Game saved successfully\n";
}


